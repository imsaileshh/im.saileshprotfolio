{
  "name": "imsaileshportfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Sailesh P Interactive Portfolio + Web Dashboard + Android Dashboard APK",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "db:generate": "node scripts/prisma-env-setup.mjs && prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx scripts/seed.ts",
    "mobile:dev": "npm --prefix mobile run start",
    "mobile:android": "npm --prefix mobile run android",
    "mobile:build": "tsx scripts/build-mobile.ts",
    "generate:types": "tsx scripts/generate-types.ts",
    "test": "jest",
    "postinstall": "node scripts/prisma-env-setup.mjs && prisma generate"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^2.19.0",
    "@prisma/client": "^6.0.0",
    "@supabase/supabase-js": "^2.109.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.0.0",
    "jose": "^6.2.9",
    "lenis": "^1.3.26",
    "lucide-react": "^0.469.0",
    "mammoth": "^1.12.1",
    "next": "^16.3.1",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-pdf": "^10.5.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.2",
    "@types/nprogress": "^0.2.3",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.1.0",
    "postcss": "^8.5.26",
    "prettier": "^3.4.2",
    "prisma": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
